{
    "id": "btp-cap-dev-stack",
    "version": "1.0.2",
    "name": "SAP BTP CAP Dev Stack",
    "description": "A development container for SAP BTP CAP applications.",
    "documentationURL": "https://github.com/navinkrishnan/devcontainer-features-btp/tree/main/src/btp-cap-dev-stack",
    "licenseURL": "https://github.com/navinkrishnan/devcontainer-features-btp/blob/main/LICENSE",
    "image": "mcr.microsoft.com/devcontainers/base:dev-bookworm",
    "options": {
        "cds-dk": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest",
                "none"
            ],
            "description": "The version of the CAP cds-dk to install."
        },
        "cf": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest",
                "none"
            ],
            "description": "The version of the Cloud Foundry CLI to install."
        },
        "mbt": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest",
                "none"
            ],
            "description": "The version of the SAP Cloud MTA Build Tool (mbt) to install."
        },
        "helm": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest",
                "none"
            ],
            "description": "The version of Helm to install."
        },
        "pack": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest",
                "none"
            ],
            "description": "The version of the Pack CLI to install."
        },
        "kubectl": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest",
                "none"
            ],
            "description": "The version of the Kubernetes CLI (kubectl) to install."
        }
    },
    "platforms": [
        "Any"
    ]

}